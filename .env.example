# Optional: only needed if the API is on a different origin than the frontend.
# Leave unset (or leave this file out) when frontend and API are on the same domain (e.g. Hostinger public_html).
# VITE_API_BASE_URL=https://api.yourdomain.com

# Optional: enable CMS-driven page section overrides.
# When unset/false, the site renders only the repo’s static translations/content (recommended for stable deployments).
# VITE_ENABLE_CMS_CONTENT=true
